rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자 = 공유 계정(rumi@rumi.com)으로 로그인한 경우.
    // rumi@rumi.com 은 실제 메일함이 아니라 email_verified 를 요구하지 않는다.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'rumi@rumi.com';
    }

    match /posts/{postId} {
      // 누구나 읽기 가능
      allow read: if true;
      // 관리자만 새 게시물 생성 및 삭제 가능
      allow create, delete: if isAdmin();
      // 관리자는 모든 필드 수정 가능(날짜/코멘트 편집 포함).
      // 게스트는 좋아요/댓글만 수정 가능 — 그 외 필드(imageUrl, captureDate 등) 변조 차단.
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['likes', 'comments']);
    }
    match /config/{document=**} {
      // 누구나 설정 정보 읽기 가능
      allow read: if true;
      // 관리자만 설정 정보 수정 가능
      allow write: if isAdmin();
    }
    match /visits/{day} {
      // 관리자만 방문 통계 조회 가능 (게스트는 데이터 자체를 읽지 못함)
      allow read: if isAdmin();
      // 누구나 카운트 시작 가능 (단, 1부터)
      allow create: if request.resource.data.count == 1;
      // 누구나 카운트 증가 가능 (단, +1씩만 허용 — 조작 방지)
      allow update: if request.resource.data.count == resource.data.count + 1;
      // 삭제 불가
      allow delete: if false;
    }
  }
}
